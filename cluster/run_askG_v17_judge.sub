# jv7 x3 over the four unjudged v17 askG rollouts, CPU-only, all API traffic from the compute
# node. 4 runs x 53 turns total x3 replicates ~= 400 calls; pinned that is well under an hour.
executable = /bin/bash
arguments  = /fast/jtaraz/LIARS/colosseum-detection/cluster/run_askG_v17_judge.sh

error  = /fast/jtaraz/LIARS/colosseum-detection/cluster/askG_v17_judge_$(Cluster).err
output = /fast/jtaraz/LIARS/colosseum-detection/cluster/askG_v17_judge_$(Cluster).out
log    = /fast/jtaraz/LIARS/colosseum-detection/cluster/askG_v17_judge_$(Cluster).log

request_gpus   = 0
request_cpus   = 4
request_memory = 8192
request_disk   = 2G
+BypassLXCfs   = "true"

queue 1
