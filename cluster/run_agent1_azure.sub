# HTCondor submit: agent1 rollouts with an Azure OpenAI deployment as the agent model.
# CPU-only — no GPU, no vLLM; the job is pure API wall-clock.
#
#   condor_submit_bid 100 cluster/run_agent1_azure.sub
#   condor_submit_bid 100 cluster/run_agent1_azure.sub \
#       config="experiments/agent1/configs/agent1_v8_inf_both_gpt54.yaml" \
#       seeds="153 154" out_dir="experiments/agent1/outputs/v8"
#
# Defaults (macros unset) come from the .sh: the v8 inference cell on gpt-5.4, seed 153.

config  = experiments/agent1/configs/agent1_v8_inf_both_gpt54.yaml
seeds   = 153
out_dir = experiments/agent1/outputs/v8

executable = /bin/bash
arguments  = "/fast/jtaraz/LIARS/colosseum-detection/cluster/run_agent1_azure.sh $(config) '$(seeds)' $(out_dir)"

error  = /fast/jtaraz/LIARS/colosseum-detection/cluster/agent1_azure_$(Cluster).err
output = /fast/jtaraz/LIARS/colosseum-detection/cluster/agent1_azure_$(Cluster).out
log    = /fast/jtaraz/LIARS/colosseum-detection/cluster/agent1_azure_$(Cluster).log

request_gpus   = 0
request_cpus   = 2
request_memory = 4096
request_disk   = 2G
+BypassLXCfs   = "true"

queue 1
