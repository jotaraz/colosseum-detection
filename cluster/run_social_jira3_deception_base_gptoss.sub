# HTCondor submit: social_jira3 DECEPTION sweep — base arm, gpt-oss-120b (local vLLM, port 8031).
# 48 runs = 8 prompt cells x 3 deception levels (none/allow/forbid) x seeds 3,4 x 1 sample.
# Study: experiments/social_jira3/social_jira3_allow_forbid_plan.md
# Submit with:
#   condor_submit_bid 100 cluster/run_social_jira3_deception_base_gptoss.sub

executable = /bin/bash
arguments  = "/fast/jtaraz/LIARS/colosseum-detection/cluster/run_social_jira3_deception_vllm.sh experiments/social_jira3/configs/social_jira3_deception_base_gptoss.yaml"

environment = "HF_TOKEN=$ENV(HF_TOKEN)"

error  = /fast/jtaraz/LIARS/colosseum-detection/cluster/sj3_deception_base_gptoss_$(Cluster).err
output = /fast/jtaraz/LIARS/colosseum-detection/cluster/sj3_deception_base_gptoss_$(Cluster).out
log    = /fast/jtaraz/LIARS/colosseum-detection/cluster/sj3_deception_base_gptoss_$(Cluster).log

# gpt-oss-120b MXFP4, tensor_parallel_size 2 -> 2x H100-80GB. Needs cuda/12.9 (see the .sh).
request_gpus   = 2
requirements   = (TARGET.CUDADeviceName == "NVIDIA H100 80GB HBM3")
request_memory = 131072
request_cpus   = 8
request_disk   = 200G
+BypassLXCfs   = "true"
queue
