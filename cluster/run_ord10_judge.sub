# jv7 x3 over the two v17 ord* rollouts, CPU-only, all API traffic from the compute node.
# ~6 runs x ~15 turns x 2-3 calls ~= 250 calls; pinned that is well under an hour.
executable = /bin/bash
arguments  = /fast/jtaraz/LIARS/colosseum-detection/cluster/run_ord10_judge.sh

error  = /fast/jtaraz/LIARS/colosseum-detection/cluster/ord10_judge_$(Cluster).err
output = /fast/jtaraz/LIARS/colosseum-detection/cluster/ord10_judge_$(Cluster).out
log    = /fast/jtaraz/LIARS/colosseum-detection/cluster/ord10_judge_$(Cluster).log

request_gpus   = 0
request_cpus   = 4
request_memory = 8192
request_disk   = 2G
+BypassLXCfs   = "true"

queue 1
