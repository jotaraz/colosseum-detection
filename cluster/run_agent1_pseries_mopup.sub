# HTCondor submit: wait for the v15 askG rollouts, then 3 jv7 judge replicates over their 33 runs.
# CPU-only. Long-lived: it gates on the rollouts finishing (up to 6h) before it judges.
#
#   condor_submit_bid 100 cluster/run_agent1_pseries_mopup.sub

executable = /bin/bash
arguments  = "/fast/jtaraz/LIARS/colosseum-detection/cluster/run_agent1_pseries_mopup.sh"

error  = /fast/jtaraz/LIARS/colosseum-detection/cluster/agent1_mopup_$(Cluster).err
output = /fast/jtaraz/LIARS/colosseum-detection/cluster/agent1_mopup_$(Cluster).out
log    = /fast/jtaraz/LIARS/colosseum-detection/cluster/agent1_mopup_$(Cluster).log

request_gpus   = 0
request_cpus   = 4
request_memory = 16384
request_disk   = 8G
+BypassLXCfs   = "true"

queue 1
