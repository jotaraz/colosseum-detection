# HTCondor submit: v15 name-set rollouts, one job per name set, 30 runs each = 90 total.
# CPU-only — pure API wall-clock on a compute node (NOT the login node).
#
#   condor_submit_bid 100 cluster/run_agent1_v15_namesets.sub

executable = /bin/bash
arguments  = "/fast/jtaraz/LIARS/colosseum-detection/cluster/run_agent1_v15_namesets.sh $(nameset)"

error  = /fast/jtaraz/LIARS/colosseum-detection/cluster/agent1_v15$(nameset)_$(Cluster).err
output = /fast/jtaraz/LIARS/colosseum-detection/cluster/agent1_v15$(nameset)_$(Cluster).out
log    = /fast/jtaraz/LIARS/colosseum-detection/cluster/agent1_v15$(nameset)_$(Cluster).log

request_gpus   = 0
request_cpus   = 4
request_memory = 16384
request_disk   = 4G
+BypassLXCfs   = "true"

queue nameset in (nb nc nd)
