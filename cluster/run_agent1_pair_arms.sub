# HTCondor submit: the pair arms (askJ-askN, askP1-askP5) on agent1.
# CPU-only — pure API wall-clock on a compute node (NOT the login node).
#
#   condor_submit_bid 100 cluster/run_agent1_pair_arms.sub
#
# Defaults to v16 x 10 arms x 3 models x 2 seeds = 60 runs. To vary it, set the environment
# below rather than editing the script:
#   environment = "FIXTURE=v15 v16 ARMS=askP1 askP3 MODELS=deepseek SEEDS=5"

executable = /bin/bash
arguments  = "/fast/jtaraz/LIARS/colosseum-detection/cluster/run_agent1_pair_arms.sh"

error  = /fast/jtaraz/LIARS/colosseum-detection/cluster/agent1_pairarms_$(Cluster).err
output = /fast/jtaraz/LIARS/colosseum-detection/cluster/agent1_pairarms_$(Cluster).out
log    = /fast/jtaraz/LIARS/colosseum-detection/cluster/agent1_pairarms_$(Cluster).log

request_gpus   = 0
request_cpus   = 4
request_memory = 16384
request_disk   = 4G
+BypassLXCfs   = "true"

queue 1
