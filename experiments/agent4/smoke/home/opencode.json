{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openrouter": {
      "options": {
        "baseURL": "http://127.0.0.1:8899/api/v1",
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    }
  },
  "mcp": {
    "world": {
      "type": "remote",
      "url": "http://127.0.0.1:8940/mcp",
      "headers": {
        "X-Agent-Name": "dana"
      }
    }
  },
  "share": "disabled",
  "autoupdate": false
}
