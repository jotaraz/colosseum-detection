# social_jira4 TARGET config — ONE local vLLM target (Qwen/Qwen3.6-35B-A3B), for the 2-GPU split.
#
# DERIVED FROM social_jira4_dual_vllm_r4.yaml.tmpl — do not edit by hand; regenerate if that file
# changes. The dual template puts both models in one 4-GPU job; this one keeps only Qwen/Qwen3.6-35B-A3B and is
# used by cluster/run_sj4_metagate_1model.sh, which requests 2 GPUs and gives both of them to this
# single server at tensor_parallel_size 2.
#
# WHY THE SPLIT EXISTS. Jobs asking for 4 GPUs on one node stopped placing: the pool had 24 H100s
# free but fragmented across nodes with 3, 2 and 1 free, so no 4-GPU hole existed anywhere. Two
# 2-GPU jobs place into holes a 4-GPU job cannot.
#
# WHAT IT COSTS, and it is not free. The dual config scores each candidate over 6 seeds spanning
# TWO models, so a step's score mixes model variance with seed variance. Split, each loop sees 3
# seeds of Qwen/Qwen3.6-35B-A3B alone and optimizes against that one model. Scores from these runs are NOT
# comparable to v4f/v4g/v4h/v4i, which were cross-model. Meta-gate pass rates still are — the gate
# judges the prompt text and never sees a rollout.
#
# This is a TEMPLATE: the run script substitutes the dunder names and rejects any that survive.
# __QWEN_PORT__ / __QWEN_GPUS__   (bf16 ~70 GB, both GPUs of the pair)

simulation:
  max_iterations: 1
  max_planning_rounds: 4
  max_conversation_steps: 5
  seed: 1
  tags: [social_jira4]

environment:
  name: SocialJiraEnvironment
  import_path: experiments.social_jira3.environment:SocialJiraEnvironment
  num_tasks: 2
  scenario_type: conflict
  assignment_filling: false
  n_distractors: 3
  n_signal_threads: 2
  signal_recipient: friend
  secrecy_request: "off"

communication_network:
  topology: complete
  num_agents: 4
  consolidate_channels: true

llm_models:
  # ---- seeds 1,2 --------------------------------------------------------------------------
  - label: vllm-qwen3.6-35b-a3b
    llm:
      provider: vllm
      vllm:
        auto_start_server: true
        persistent_server: true        # also stops ensure_server from killing the OTHER server
        health_check_path: "/models"
        startup_timeout: 3600          # GDN kernels JIT-compile on first load
        connection_timeout: 600
        env:
          HF_HOME: "/fast/jtaraz/hf_cache"
        params:
          max_tokens: 20000
          temperature: 0.7
        models:
          - checkpoint: "Qwen/Qwen3.6-35B-A3B"
            host: "127.0.0.1"
            port: __QWEN_PORT__
            request_timeout: 600
            tensor_parallel_size: 2
            gpu_memory_utilization: 0.9
            max_model_len: 128000
            trust_remote_code: true
            tool_call_parser: "qwen3_coder"   # XML tool calls, NOT hermes-JSON
            reasoning_parser: "qwen3"
            env:
              CUDA_VISIBLE_DEVICES: "__QWEN_GPUS__"
            # The trailing --tool-call-parser is NOT a copy-paste slip; removing it silently breaks
            # every qwen tool call. terrarium's _apply_vllm_model_presets has a preset matching any
            # model whose name contains "qwen" that forces --tool-call-parser hermes, and it applies
            # via _ensure_flag_with_value, which OVERWRITES the first occurrence in this list (and
            # appends hermes outright if the flag is absent). Hermes expects JSON; Qwen3.6 emits XML
            # <function=...>, so the parser throws, the call is returned as plain content, and no
            # tool event is ever recorded.
            #
            # Measured before this fix: qwen's execution phase parsed 0/160 turns and produced zero
            # assign_task events in every run, while gpt-oss managed 96%/228. The 98 unparsed
            # responses were well-formed — vLLM's own qwen3coder regexes extract them 54/54 — so the
            # only defect was which parser read them.
            #
            # The preset only rewrites the FIRST occurrence and argparse keeps the LAST, so the
            # duplicate at the end of this list is what actually reaches the server. Verify after any
            # config change: the startup log's "non-default args" must say 'tool_call_parser':
            # 'qwen3_coder', NOT 'hermes'.
            additional_args:
              - "--enable-auto-tool-choice"
              - "--tool-call-parser"
              - "qwen3_coder"        # <- the preset overwrites THIS one with hermes
              - "--reasoning-parser"
              - "qwen3"
              - "--tool-call-parser"
              - "qwen3_coder"        # <- ... so this trailing one is what argparse keeps

experiment:
  tag: social_jira4_dual_vllm_r4
  planning_rounds: 4
  min_planning_rounds: 2
  early_stop: true
  max_conversation_steps: 5
  log_prompts: true
  robust_assignment: false
