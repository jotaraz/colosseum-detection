# social_jira4 — Qwen3.6-35B-A3B TARGET via LOCAL vLLM (framework provider:vllm, auto_start_server).
# Mirrors social_jira3's qwen3.6 submit. 2x H100-80GB (tensor_parallel_size: 2 in the YAML must match
# request_gpus). Submit from the repo root:
#     condor_submit_bid 100 experiments/social_jira4/cluster/qwen_vllm.sub

executable = /bin/bash
arguments  = /fast/jtaraz/LIARS/colosseum-detection/experiments/social_jira4/cluster/run_sj4_vllm.sh experiments/social_jira4/configs/social_jira4_qwen3_6_35b_a3b_vllm_r4.yaml vllm-qwen3.6-35b-a3b experiments/social_jira4/outputs/cluster_qwen_vllm_r4

environment = "HF_TOKEN=$ENV(HF_TOKEN)"

output = /fast/jtaraz/LIARS/colosseum-detection/experiments/social_jira4/cluster/qwen_vllm.out
error  = /fast/jtaraz/LIARS/colosseum-detection/experiments/social_jira4/cluster/qwen_vllm.err
log    = /fast/jtaraz/LIARS/colosseum-detection/experiments/social_jira4/cluster/qwen_vllm.log

request_gpus   = 2
requirements   = (TARGET.CUDADeviceName == "NVIDIA H100 80GB HBM3")
request_memory = 131072
request_cpus   = 8
request_disk   = 200G
+BypassLXCfs   = "true"

queue
