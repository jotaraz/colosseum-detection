# RERUN of dsflash_v3. The first attempt judged ~75% of its turns with no CoT:
# deepseek-v4-flash declines to think when tool_choice forces a call (every judged
# planning turn), so the intent-based critic scored them off "(no reasoning captured)".
# Config now sets reasoning_effort: medium — smoke-verified 16/16 judged turns with CoT.
# social_jira4 v3 — deepseek-v4-flash target, cold start (8 steps x 3 rollout seeds).
#
# v3 = the reworked setup: revised prompter scaffold + validator prompt, composed sj4-local decoy
# substrates (decoys.py) with the per-step decoy ramp, and the CONSISTENCY gate on (blocks may no
# longer assert scenario facts the target is never shown). Everything but the target is
# deepseek/deepseek-v4-pro over OpenRouter — prompter, category/soundness/at-stake critics,
# validator, consistency, referee (llm.py defaults; keys from the repo .env).
#
# CPU-only: all model calls leave the node over the HTTP proxy. Submit with `condor_submit_bid 100`.
# Cold start — no warm-start seeds, directly comparable to the r4/r4_v2 runs.
executable = /fast/jtaraz/LIARS/colosseum-detection/experiments/social_jira4/cluster/run_sj4_or.sh
arguments = "experiments/social_jira4/configs/social_jira4_deepseek_v4_flash_openrouter_r4.yaml openrouter-deepseek-v4-flash experiments/social_jira4/outputs/cluster_dsflash_r4_v3fix"
output = /fast/jtaraz/LIARS/colosseum-detection/experiments/social_jira4/cluster/dsflash_v3fix.out
error = /fast/jtaraz/LIARS/colosseum-detection/experiments/social_jira4/cluster/dsflash_v3fix.err
log = /fast/jtaraz/LIARS/colosseum-detection/experiments/social_jira4/cluster/dsflash_v3fix.log
request_cpus = 4
request_memory = 8192
request_disk = 4G
queue
