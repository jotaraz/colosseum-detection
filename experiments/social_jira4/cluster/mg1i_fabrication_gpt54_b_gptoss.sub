# social_jira4 v4i -- 2-GPU SPLIT: gpt-oss-120b only, seeds 4,5,6.
# prompter = gpt54, 3 steps, K=5 repairs, inbox quit3, gate dspro x2 @T=1.0.
# decoys = calendar+ops_feed+equipment
#
# THIS IS HALF A RUN. v4i_fabrication_gpt54_b used to be one 4-GPU job serving
# both targets over 6 seeds; it is now this job plus v4i_fabrication_gpt54_b_qwen. Scores here are over
# seeds 4,5,6 of gpt-oss-120b ALONE.
#
# WHY. The 4-GPU jobs stopped placing -- 24 H100s free pool-wide but fragmented across nodes with
# 3, 2 and 1 free, so no 4-GPU hole existed. Two 2-GPU jobs fit where one 4-GPU job could not.
#
# WHAT IT COSTS. The dual runs scored each candidate across 6 seeds spanning both models, and the
# prompter optimized against both at once. This loop optimizes against one model's three seeds, so
# its SCORES ARE NOT COMPARABLE to v4f/v4g/v4h/v4i dual runs. Meta-gate pass rates remain
# comparable: the gate reads the prompt and never sees a rollout. Compare the two halves to each
# other for a per-model read, and to the dual runs only on gate behaviour.
#
# The split is by MODEL, not by seed within a model, because neither target fits on one 80 GB card
# at these context lengths -- qwen is ~70 GB bf16 at 128k, gpt-oss ~63 GB mxfp4 at 64k -- so each
# server still needs tensor_parallel_size 2. Seeds and model-label are set by the runner, not here.
#
# 2x H100-80GB, one server on both. Port 8307. request_memory 65536 (dual runs peaked 17-22 GB).
# Submit with `condor_submit_bid 200`. Node exclusion: i101, i104, i201.
executable = /fast/jtaraz/LIARS/colosseum-detection/experiments/social_jira4/cluster/run_sj4_metagate_1model.sh
arguments  = "experiments/social_jira4/outputs/v4i_fabrication_gpt54_b_gptoss 8307 fabrication 3 gpt54 gptoss dspro,dspro --decoys calendar+ops_feed+equipment --inbox quit3 --meta-gate-temperature 1.0"

environment = "HF_TOKEN=$ENV(HF_TOKEN)"

output = /fast/jtaraz/LIARS/colosseum-detection/experiments/social_jira4/cluster/mg1i_fabrication_gpt54_b_gptoss.out
error  = /fast/jtaraz/LIARS/colosseum-detection/experiments/social_jira4/cluster/mg1i_fabrication_gpt54_b_gptoss.err
log    = /fast/jtaraz/LIARS/colosseum-detection/experiments/social_jira4/cluster/mg1i_fabrication_gpt54_b_gptoss.log

request_gpus   = 2
requirements   = (TARGET.CUDADeviceName == "NVIDIA H100 80GB HBM3") && (TARGET.Machine != "i101.internal.cluster.is.localnet") && (TARGET.Machine != "i104.internal.cluster.is.localnet") && (TARGET.Machine != "i201.internal.cluster.is.localnet")
request_memory = 65536
request_cpus   = 8
request_disk   = 200G
+BypassLXCfs   = "true"

queue
